# LabNana API fallback 配置
# 默认生图已切换为 Codex 内置 image_gen/image2，不需要此文件。
# 只有用户明确要求 CLI/API fallback 时才复制此文件并填入 key。
# 复制此文件为 .labnana.env 并填入你自己的 key
# 申请: https://labnana.com

LABNANA_API_KEY=your_labnana_api_key_here
LABNANA_API_URL=https://api.labnana.com
LABNANA_MODEL=gpt-image-2
LABNANA_PROVIDER=openai
